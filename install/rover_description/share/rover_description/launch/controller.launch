<launch>

<rosparam file="$(find rover_description)/launch/controller.yaml" command="load"/>
<node name="controller_spawner" pkg="controller_manager" type="spawner" respawn="false" output="screen" ns="Rover" args="Revolute 1_position_controller Revolute 2_position_controller Revolute 3_position_controller Revolute 15_position_controller Revolute 17_position_controller Revolute 20_position_controller Revolute 22_position_controller Revolute 31_position_controller Revolute 32_position_controller Revolute 33_position_controller Revolute 34_position_controller Revolute 39_position_controller Revolute 40_position_controller Revolute 41_position_controller Revolute 42_position_controller joint_state_controller "/>
<node name="robot_state_publisher" pkg="robot_state_publisher" type="robot_state_publisher" respawn="false" output="screen">
  <remap from="/joint_states" to="/Rover/joint_states"/>
</node>

</launch>